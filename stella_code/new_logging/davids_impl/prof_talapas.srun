#!/bin/bash
#SBATCH --account=cis431_531    ### Account to charge
#SBATCH --job-name=spmv_gpu     ### Job Name
#SBATCH --output=spmv_%j.out    ### File in which to store job output
#SBATCH --error=spmv_%j.err     ### File in which to store job error messages
#SBATCH --partition=gpu         ### Quality of Service
#SBATCH --time=00:20:00         ### Increased time limit (Profiling is slow!)
#SBATCH --nodes=1               ### Node count
#SBATCH --ntasks-per-node=1     ### Tasks per node
#SBATCH --gres=gpu:1            ### Number of GPUs
#SBATCH --cpus-per-task=28      ### Number of threads

MATRIX_DIR="matrices/"
OUTPUT_DIR="test_out/"

module load gcc
module load cuda

export OMP_PROC_BIND=true
export OMP_NUM_THREADS=28

# PROFILING COMMAND
# --clock-control none: Required for MIG (shared) GPUs to prevent permission errors
# --cache-control none: Prevents cache flushing errors on shared memory slices
ncu \
  --clock-control none \
  --cache-control none \
  -o profile_report \
  -f \
  --set full \
  --target-processes all \
  ./spmv "$MATRIX_DIR"/cant/cant.mtx "$MATRIX_DIR"/cant/b.mtx test_out/ans.mtx