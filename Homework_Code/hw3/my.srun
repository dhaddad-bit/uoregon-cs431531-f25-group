#!/bin/bash
#SBATCH --account=cis431_531
#SBATCH --partition=compute       ### 'short' is usually faster queue for small jobs
#SBATCH --job-name=spmv_scaling
#SBATCH --time=00:10:00
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=28      ### Reserve full node capacity to prevent noise

# === JOB ARRAY CONFIGURATION ===
# We have 6 test cases (1, 2, 4, 8, 16, 28 threads)
# Indices 0 through 5
#SBATCH --array=0-5

#SBATCH --output=output/spmv_cpu_%A_%a.out
#SBATCH --error=output/spmv_cpu_%A_%a.err

# Load GCC
module load gcc

# Ensure output directory exists
mkdir -p output

# Define the thread counts we want to test
declare -a THREAD_COUNTS=(1 2 4 8 16 28)

# Get the thread count for *this* specific array task
export OMP_NUM_THREADS=${THREAD_COUNTS[$SLURM_ARRAY_TASK_ID]}

# Processor binding settings (from your template)
export OMP_PLACES="cores"
export OMP_PROC_BIND='close' 
export OMP_DISPLAY_ENV='true'

echo "================================================="
echo "  Running Array Task ID: $SLURM_ARRAY_TASK_ID"
echo "  Threads: $OMP_NUM_THREADS"
echo "================================================="

# Run the SpMV executable
# output file is tagged with thread count for safety
./spmv cant/cant.mtx cant/b.mtx output/result_cpu_${OMP_NUM_THREADS}.mtx

echo "-------------------------------------------------"
echo "Done."