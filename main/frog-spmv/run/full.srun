#!/bin/bash
#SBATCH --account=sgreenvoss
#SBATCH --job-name=spmv_gpu   ### Job Name
#SBATCH --output=spmv_%j.out  ### File in which to store job output
#SBATCH --error=spmv_%j.err   ### File in which to store job error messages
#SBATCH --partition=short       ### Quality of Service (like a queue in PBS)
#SBATCH --time=00:30:00     ### Wall clock time limit in Days-HH:MM:SS
#SBATCH --nodes=1             ### Node count required for the job
#SBATCH --ntasks-per-node=1   ### Nuber of tasks to be launched per Node
#SBATCH --gres=gpu:1          ### General REServation of gpu:number of gpus
#SBATCH --cpus-per-task=28     ### Number of threads per task (OMP threads)

MATRIX_DIR="matrices/"
OUTPUT_DIR="test_out/"

module load gcc
module load cuda
#module load gcc/7.3

export OMP_PROC_BIND=true
export OMP_NUM_THREADS=28

#put the CSV headers into the output file, detemined by the job ID
echo "matrix,name,config,time_s,conv_s,gflops,gbps,err" >> "$OUTPUT_DIR"output-"$SLURM_JOB_ID".csv

for item in "$MATRIX_DIR"/*; do
	if [ -d "$item" ]; then
		echo "matrix folder? $item"
		vector=$(ls "$item"/b* | head -n 1)
		vector_base=$(basename "$vector")
		matrix=$(ls "$item" --ignore="$vector_base" --ignore="ans*" | head -n 1)
		matrix="$item/$matrix"
		echo "mat: $matrix, vec: $vector"	
		./spmv "$matrix" "$vector" test_out/ans.mtx >> "$OUTPUT_DIR"output-"$SLURM_JOB_ID".csv
	fi
done
#./spmv cant/cant.mtx cant/b.mtx test_out/ans.mtx
